# Pengamanan dasar untuk hosting Apache (cPanel dan sejenisnya).

DirectoryIndex index.php

# File pengaturan dan folder program tidak boleh dibuka lewat browser.
<FilesMatch "^(config\.php|config\.sample\.php|patch.*\.py)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/.*/lib/.*$

# Alamat pendek halaman admin: /sysAdmin dan /infraAdmin.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sysAdmin/?$ sysadmin.php [NC,QSA,L]
    RewriteRule ^infraAdmin/?$ infraadmin.php [NC,QSA,L]
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>
